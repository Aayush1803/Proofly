# PROOFLY — Environment Variables
# Copy this file to .env.local and fill in your real values

# ──────────────────────────────────────────────────────────────
# NEXTAUTH (required)
# ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=proofly-dev-secret-change-in-production

# ──────────────────────────────────────────────────────────────
# GOOGLE OAUTH
# Steps to get credentials:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Add http://localhost:3000/api/auth/callback/google as Authorized redirect URI
# ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ──────────────────────────────────────────────────────────────
# DATABASE (Neon PostgreSQL / local Postgres)
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/proofly

# ──────────────────────────────────────────────────────────────
# FASTAPI BACKEND (ML analysis service)
#
# Development:
#   Set to "mock" to use the built-in mock API (no backend needed)
#   Set to http://localhost:8000 when running FastAPI locally
#
# Production:
#   Set to your deployed Render URL, e.g.:
#   https://proofly-api.onrender.com
#
# NEXT_PUBLIC_ prefix makes this available in browser code.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=mock

# Optional: force mock mode regardless of API_URL
# NEXT_PUBLIC_MOCK_API=true

# ──────────────────────────────────────────────────────────────
# LEGACY (kept for backward compat — not used by new API layer)
# ──────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-key-here  ← no longer used by frontend
